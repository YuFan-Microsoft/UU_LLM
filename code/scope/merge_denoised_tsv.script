// cosmos09 / MSN.DnI. Merge the 22 generated structured streams into 16 TSVs (bucketed by UserId) without removing duplicate rows.
// A single ADLS file allows at most 50000 committed blocks across all writing vertices, so one TSV cannot hold the merged data.
#DECLARE Root string = "/shares/UDC/RnR/MaiProfileV3/AllUsers_V4_Backfill/Denoising";
#DECLARE OutputDir string = @Root + "/From-20260503-To-20261003";

#DECLARE Input20260509 string = @Root + "/2026-05-09/ForGptLabeling.ss";
rows20260509 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260509);

#DECLARE Input20260516 string = @Root + "/2026-05-16/ForGptLabeling.ss";
rows20260516 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260516);

#DECLARE Input20260523 string = @Root + "/2026-05-23/ForGptLabeling.ss";
rows20260523 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260523);

#DECLARE Input20260530 string = @Root + "/2026-05-30/ForGptLabeling.ss";
rows20260530 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260530);

#DECLARE Input20260606 string = @Root + "/2026-06-06/ForGptLabeling.ss";
rows20260606 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260606);

#DECLARE Input20260613 string = @Root + "/2026-06-13/ForGptLabeling.ss";
rows20260613 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260613);

#DECLARE Input20260620 string = @Root + "/2026-06-20/ForGptLabeling.ss";
rows20260620 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260620);

#DECLARE Input20260627 string = @Root + "/2026-06-27/ForGptLabeling.ss";
rows20260627 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260627);

#DECLARE Input20260704 string = @Root + "/2026-07-04/ForGptLabeling.ss";
rows20260704 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260704);

#DECLARE Input20260711 string = @Root + "/2026-07-11/ForGptLabeling.ss";
rows20260711 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260711);

#DECLARE Input20260718 string = @Root + "/2026-07-18/ForGptLabeling.ss";
rows20260718 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260718);

#DECLARE Input20260725 string = @Root + "/2026-07-25/ForGptLabeling.ss";
rows20260725 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260725);

#DECLARE Input20260801 string = @Root + "/2026-08-01/ForGptLabeling.ss";
rows20260801 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260801);

#DECLARE Input20260808 string = @Root + "/2026-08-08/ForGptLabeling.ss";
rows20260808 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260808);

#DECLARE Input20260815 string = @Root + "/2026-08-15/ForGptLabeling.ss";
rows20260815 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260815);

#DECLARE Input20260822 string = @Root + "/2026-08-22/ForGptLabeling.ss";
rows20260822 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260822);

#DECLARE Input20260829 string = @Root + "/2026-08-29/ForGptLabeling.ss";
rows20260829 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260829);

#DECLARE Input20260905 string = @Root + "/2026-09-05/ForGptLabeling.ss";
rows20260905 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260905);

#DECLARE Input20260912 string = @Root + "/2026-09-12/ForGptLabeling.ss";
rows20260912 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260912);

#DECLARE Input20260919 string = @Root + "/2026-09-19/ForGptLabeling.ss";
rows20260919 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260919);

#DECLARE Input20260926 string = @Root + "/2026-09-26/ForGptLabeling.ss";
rows20260926 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20260926);

#DECLARE Input20261003 string = @Root + "/2026-10-03/ForGptLabeling.ss";
rows20261003 =
    SELECT UserId, Date, Source, Action, AdditionalData
    FROM (SSTREAM @Input20261003);

merged =
    SELECT * FROM rows20260509
    UNION ALL SELECT * FROM rows20260516
    UNION ALL SELECT * FROM rows20260523
    UNION ALL SELECT * FROM rows20260530
    UNION ALL SELECT * FROM rows20260606
    UNION ALL SELECT * FROM rows20260613
    UNION ALL SELECT * FROM rows20260620
    UNION ALL SELECT * FROM rows20260627
    UNION ALL SELECT * FROM rows20260704
    UNION ALL SELECT * FROM rows20260711
    UNION ALL SELECT * FROM rows20260718
    UNION ALL SELECT * FROM rows20260725
    UNION ALL SELECT * FROM rows20260801
    UNION ALL SELECT * FROM rows20260808
    UNION ALL SELECT * FROM rows20260815
    UNION ALL SELECT * FROM rows20260822
    UNION ALL SELECT * FROM rows20260829
    UNION ALL SELECT * FROM rows20260905
    UNION ALL SELECT * FROM rows20260912
    UNION ALL SELECT * FROM rows20260919
    UNION ALL SELECT * FROM rows20260926
    UNION ALL SELECT * FROM rows20261003;

bucketed =
    SELECT UserId, Date, Source, Action, AdditionalData, UserBucket.Of(UserId, 16) AS Bucket
    FROM merged;

bucket00 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 0;
OUTPUT bucket00
TO @OutputDir + "/ForGptLabeling_00.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket01 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 1;
OUTPUT bucket01
TO @OutputDir + "/ForGptLabeling_01.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket02 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 2;
OUTPUT bucket02
TO @OutputDir + "/ForGptLabeling_02.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket03 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 3;
OUTPUT bucket03
TO @OutputDir + "/ForGptLabeling_03.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket04 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 4;
OUTPUT bucket04
TO @OutputDir + "/ForGptLabeling_04.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket05 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 5;
OUTPUT bucket05
TO @OutputDir + "/ForGptLabeling_05.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket06 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 6;
OUTPUT bucket06
TO @OutputDir + "/ForGptLabeling_06.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket07 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 7;
OUTPUT bucket07
TO @OutputDir + "/ForGptLabeling_07.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket08 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 8;
OUTPUT bucket08
TO @OutputDir + "/ForGptLabeling_08.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket09 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 9;
OUTPUT bucket09
TO @OutputDir + "/ForGptLabeling_09.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket10 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 10;
OUTPUT bucket10
TO @OutputDir + "/ForGptLabeling_10.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket11 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 11;
OUTPUT bucket11
TO @OutputDir + "/ForGptLabeling_11.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket12 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 12;
OUTPUT bucket12
TO @OutputDir + "/ForGptLabeling_12.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket13 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 13;
OUTPUT bucket13
TO @OutputDir + "/ForGptLabeling_13.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket14 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 14;
OUTPUT bucket14
TO @OutputDir + "/ForGptLabeling_14.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

bucket15 = SELECT UserId, Date, Source, Action, AdditionalData FROM bucketed WHERE Bucket == 15;
OUTPUT bucket15
TO @OutputDir + "/ForGptLabeling_15.tsv"
ORDER BY UserId ASC, Date ASC
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

#CS
public static class UserBucket
{
    // Deterministic FNV-1a; string.GetHashCode is randomized per process.
    public static int Of(string userId, int count)
    {
        uint h = 2166136261;
        if (userId != null)
        {
            foreach (char c in userId)
            {
                h ^= c;
                h = unchecked(h * 16777619);
            }
        }
        return (int)(h % (uint)count);
    }
}
#ENDCS

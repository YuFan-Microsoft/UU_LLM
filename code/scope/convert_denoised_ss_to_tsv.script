// cosmos09 / MSN.DnI. Only the 22 single-date folders from the supplied listing.
#DECLARE Root string = "/shares/UDC/RnR/MaiProfileV3/AllUsers_V4_Backfill/Denoising";

#DECLARE Input20260509 string = @Root + "/2026-05-09/ForGptLabeling.ss";
#DECLARE Output20260509 string = @Root + "/2026-05-09/ForGptLabeling.tsv";
raw20260509 = SSTREAM @Input20260509;
kept20260509 =
    SELECT UserId, Date, Source, Action
    FROM raw20260509
    WHERE denoising_label == 1;
OUTPUT kept20260509
TO @Output20260509
USING DefaultTextOutputter(delimiter: '\t', outputHeader: true);

